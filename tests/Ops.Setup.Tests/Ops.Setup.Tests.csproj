<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CompanyOps.Setup.Tests</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj.*\**;bin\**;bin.*\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ops.Setup\Ops.Setup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Test-CompanyOpsUpdate.ps1" Link="Test-CompanyOpsUpdate.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\Update-CompanyOps.ps1" Link="Update-CompanyOps.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
