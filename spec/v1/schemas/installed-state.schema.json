{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ops.company/schemas/v1/installed-state.schema.json",
  "title": "Ops Installed State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "manifestKind",
    "metadata",
    "release",
    "components",
    "lastOperation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "ops.company/v1"
    },
    "manifestKind": {
      "const": "InstalledState"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "environment",
        "hostId",
        "generation",
        "observedAt"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/definitions/id"
        },
        "environment": {
          "$ref": "#/definitions/id"
        },
        "hostId": {
          "$ref": "#/definitions/hostId"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "releaseManifestSha256",
        "currentPath",
        "installedAt"
      ],
      "properties": {
        "version": {
          "$ref": "#/definitions/version"
        },
        "releaseManifestSha256": {
          "$ref": "#/definitions/sha256"
        },
        "currentPath": {
          "$ref": "#/definitions/absoluteWindowsPath"
        },
        "previousVersion": {
          "$ref": "#/definitions/version"
        },
        "previousPath": {
          "$ref": "#/definitions/absoluteWindowsPath"
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "kind",
          "adapter",
          "nativeId",
          "runtimeState",
          "healthState"
        ],
        "properties": {
          "componentId": {
            "$ref": "#/definitions/id"
          },
          "kind": {
            "enum": [
              "windowsService",
              "iisSite",
              "staticSite",
              "scheduledTask",
              "pm2Legacy"
            ]
          },
          "adapter": {
            "enum": [
              "scm",
              "iis",
              "taskScheduler",
              "pm2Legacy"
            ]
          },
          "nativeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "runtimeState": {
            "enum": [
              "unknown",
              "stopped",
              "starting",
              "running",
              "stopping",
              "failed"
            ]
          },
          "healthState": {
            "enum": [
              "unknown",
              "notConfigured",
              "healthy",
              "unhealthy"
            ]
          },
          "probedAt": {
            "type": "string",
            "format": "date-time"
          },
          "healthDetail": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "lastOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "action",
        "status",
        "startedAt"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
        },
        "action": {
          "enum": [
            "discover",
            "install",
            "update",
            "rollback",
            "start",
            "stop",
            "restart"
          ]
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "rolledBack"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 63
    },
    "hostId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 100
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "pattern": "^[A-Za-z]:\\\\(?:[^<>:\"/\\\\|?*]+\\\\?)*$",
      "minLength": 3,
      "maxLength": 240
    }
  }
}
