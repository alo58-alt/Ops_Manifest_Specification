{
  "$schema": "../../spec/v1/schemas/environment-binding.schema.json",
  "apiVersion": "ops.company/v1",
  "manifestKind": "EnvironmentBinding",
  "metadata": {
    "projectId": "sample-system",
    "environment": "production",
    "hostId": "WIN-OPS-01",
    "revision": 1
  },
  "roots": {
    "install": "C:\\CompanyOps\\Apps\\sample-system",
    "data": "C:\\CompanyOps\\Data\\sample-system",
    "logs": "C:\\CompanyOps\\Logs\\sample-system"
  },
  "componentBindings": [
    {
      "componentId": "api",
      "serviceAccountRef": "sample-system-runtime",
      "nativeName": "Company.SampleSystem.Api"
    }
  ],
  "portBindings": [],
  "settings": [
    {
      "key": "DATABASE_URL",
      "value": "Server=production;Password=do-not-store-this",
      "secretRef": "windows-credential/sample-system/database-url"
    }
  ]
}
